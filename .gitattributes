# 기본 텍스트 파일은 LF로 저장
* text=auto eol=lf

# Windows 실행 파일은 CRLF 사용
*.bat text eol=crlf
*.cmd text eol=crlf

# 소스 및 설정 파일
*.java text eol=lf
*.kt text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.py text eol=lf

# 이미지 및 바이너리 파일
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.zip binary
*.pdf binary
.gitlab/merge_request_templates/*.md text eol=lf
