{
  "name": "ssabangpalbang-frontend",
  "version": "1.0.1",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "test": "npm run test:checklist && npm run test:map-sheet && npm run test:app-link && npm run test:field-visit-return && npm run test:field-track && npm run test:release-ui",
    "test:app-link": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/features/report/reportShareLink.test.mjs src/features/report/reportOpenLanding.test.mjs src/features/navigation/pendingAppLinkStore.test.mjs src/features/notification/notificationResponseNavigation.test.mjs",
    "test:field-visit-return": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/features/field/activeFieldVisitReturn.test.mjs",
    "test:field-track": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/features/field/fieldTrackSnapshot.test.mjs",
    "test:release-ui": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/features/field/navigationCamera.test.mjs src/lib/geo.test.mjs src/features/study/studyNoticePagination.test.mjs src/features/study/studySchedulePicker.test.mjs",
    "test:checklist": "node --test src/features/checklist/checklistModel.test.mjs src/features/checklist/savePendingTextDrafts.test.mjs",
    "test:map-sheet": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/features/map/mapSheetControls.test.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans-kr": "^0.4.1",
    "@expo-google-fonts/noto-sans-kr": "^0.4.3",
    "@expo/metro-runtime": "~57.0.7",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-seoul/kakao-login": "^5.4.2",
    "@rnmapbox/maps": "10.3.5",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@turf/buffer": "^7.3.5",
    "@uginy/react-native-liquid-glass": "^1.2.6",
    "expo": "~57.0.11",
    "expo-asset": "~57.0.9",
    "expo-audio": "~57.0.3",
    "expo-auth-session": "~57.0.6",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.9",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-manipulator": "~57.0.8",
    "expo-image-picker": "~57.0.8",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.8",
    "expo-media-library": "~57.0.3",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-sensors": "~57.0.2",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.8",
    "expo-updates": "~57.0.12",
    "expo-web-browser": "~57.0.2",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.83.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "prettier": "^3.4.0",
    "typescript": "~6.0.3"
  }
}
